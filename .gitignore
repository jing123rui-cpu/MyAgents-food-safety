# 忽略
.DS_Store
Thumbs.db
*.tmp
*.log

# 本地覆盖与凭据，绝不提交
.env
.env.*
*.token
secrets/
.venv/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# 本地语义索引（可重建，不入库）
audit/.index/

# 派生大文件不入库（与父仓库 MyAgents 口径一致）
*.pdf
*.xml
*.mgf
*.zip
*.tar
*.tar.gz
*.tgz
references/downloads/
references/**/*.txt

# 同步脚本产生的临时目录
.tmp/
